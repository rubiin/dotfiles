#!/usr/bin/env bash
set -euo pipefail

if ! command -v git-filter-repo >/dev/null 2>&1; then
  echo "Error: git-filter-repo not found. Install it (e.g. pip install git-filter-repo)." >&2
  exit 1
fi

echo "What do you want to remove from Git history?"
echo
echo "1) Images"
echo "2) Fonts"
echo "3) Videos"
echo "4) ZIPs"
echo "5) All"
echo

read -rp "Select an option [1-5]: " choice

case "$choice" in
1)
  PATTERNS=(
    '*.png' '*.PNG'
    '*.jpg' '*.JPG'
    '*.jpeg' '*.JPEG'
    '*.gif' '*.GIF'
    '*.webp' '*.WEBP'
    '*.svg' '*.SVG'
    '*.ico' '*.ICO'
  )
  ;;

2)
  PATTERNS=(
    '*.ttf' '*.TTF'
    '*.otf' '*.OTF'
    '*.woff' '*.WOFF'
    '*.woff2' '*.WOFF2'
    '*.eot' '*.EOT'
  )
  ;;

3)
  PATTERNS=(
    '*.mp4' '*.MP4'
    '*.mov' '*.MOV'
    '*.avi' '*.AVI'
    '*.mkv' '*.MKV'
    '*.webm' '*.WEBM'
    '*.flv' '*.FLV'
  )
  ;;

4)
  PATTERNS=(
    '*.zip' '*.ZIP'
  )
  ;;

5)
  PATTERNS=(
    '*.png' '*.PNG'
    '*.jpg' '*.JPG'
    '*.jpeg' '*.JPEG'
    '*.gif' '*.GIF'
    '*.webp' '*.WEBP'
    '*.svg' '*.SVG'
    '*.ico' '*.ICO'
    '*.ttf' '*.TTF'
    '*.otf' '*.OTF'
    '*.woff' '*.WOFF'
    '*.woff2' '*.WOFF2'
    '*.eot' '*.EOT'
    '*.mp4' '*.MP4'
    '*.mov' '*.MOV'
    '*.avi' '*.AVI'
    '*.mkv' '*.MKV'
    '*.webm' '*.WEBM'
    '*.flv' '*.FLV'
    '*.zip' '*.ZIP'
  )
  ;;

*)
  echo "Invalid option." >&2
  exit 1
  ;;
esac

echo
echo "Cleaning Git history..."
echo

# Build a path list file for git-filter-repo (one glob per line).
# Using --path-file is more reliable than repeated --path-glob args.
path_file="$(mktemp)"
trap 'rm -f "$path_file"' EXIT

printf '%s\n' "${PATTERNS[@]}" > "$path_file"

git filter-repo --invert-paths --path-file "$path_file" --force

git reflog expire --expire=now --all
git gc --prune=now --aggressive

echo
echo "Git history cleaned successfully."
echo
echo "Next steps:"
echo "  git remote add origin <REMOTE_URL>"
echo "  git push origin --force --all"
echo "  git push origin --force --tags"
