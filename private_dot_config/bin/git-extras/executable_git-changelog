#!/usr/bin/env bash
set -euo pipefail

# Originally taken from
# [visionmedia/git-extras](https://github.com/visionmedia/git-extras)
# (MIT License).

CHANGELOG='CHANGELOG.md'
DATE=$(date +'%B %d, %Y')

# Extract project name from the first heading in the existing changelog.
if [[ -f "$CHANGELOG" ]] && [[ -r "$CHANGELOG" ]]; then
  PROJECT=$(grep -E '^# \w+' "$CHANGELOG" | sed -e 's/^# \([a-zA-Z]*\).*/\1/' | head -n 1)
else
  PROJECT='PROJECT'
fi

HEAD="# $PROJECT $1 ($DATE)"

if [[ "$1" == "--list" ]]; then
  version=$(git for-each-ref refs/tags --sort="-*authordate" --format='%(refname)' \
    --count=1 | sed 's/^refs\/tags\///')
  if [[ -z "$version" ]]; then
    git log --pretty="format:* %s"
  else
    git log --pretty="format:* %s" "$version"..
  fi
else
  tmp="$(mktemp)"
  trap 'rm -f "$tmp"' EXIT
  echo "$HEAD" > "$tmp"
  "$0" --list >> "$tmp"
  printf '\n' >> "$tmp"
  if [[ -f "$CHANGELOG" ]]; then
    cat "$CHANGELOG" >> "$tmp"
  fi
  mv "$tmp" "$CHANGELOG"
  [[ -n "${EDITOR:-}" ]] && "$EDITOR" "$CHANGELOG"
fi
