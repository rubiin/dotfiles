#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: portwtf <port>" >&2
  exit 1
fi

port="$1"

# Get PIDs listening on the given port. lsof -ti returns one PID per line.
pids=$(lsof -ti tcp:"$port" 2>/dev/null || true)

if [[ -z "$pids" ]]; then
  exit 0
fi

# Output the process name(s) to stderr so they aren't piped along.
while IFS= read -r pid; do
  pid_name=$(ps -o comm= -p "$pid" 2>/dev/null || echo "unknown")
  echo >&2 -n "$pid_name "
done <<< "$pids"
echo >&2

# Print PIDs (one per line) so the output can be piped, e.g. to pbcopy/xargs.
echo "$pids"
