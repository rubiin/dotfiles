

# ===== START Powerlevel10k Instant Prompt =====
# Must be sourced before p10k initializes (i.e. before `eval "$(sheldon source)"`)
# and before anything that prints to the terminal.
if [[ -r "${ZDOTDIR:-$HOME}/.p10k.zsh" ]] && [[ -r "$XDG_CACHE_HOME/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "$XDG_CACHE_HOME/p10k-instant-prompt-${(%):-%n}.zsh"
fi
# ===== END Powerlevel10k Instant Prompt =====

zmodload zsh/zprof

# must run eagerly at startup (can't be evalcached) — it loads the prompt (p10k)
eval "$(sheldon source)"

# ===== START Initialize prompt =====
# Powerlevel10k: theme is loaded by sheldon (plugins.powerlevel10k); here we only
# apply the user's config on top of it. Starship is the fallback.
if [[ -r "${ZDOTDIR:-$HOME}/.p10k.zsh" ]]; then
    export POWERLEVEL10K_TRANSIENT_PROMPT=same-dir
    source "${ZDOTDIR:-$HOME}/.p10k.zsh"

elif command -v starship &>/dev/null; then
    # ===== START Initialize Starship prompt =====
    _evalcache starship init zsh
    export STARSHIP_CACHE="$XDG_CACHE_HOME/starship"
    export STARSHIP_CONFIG="$XDG_CONFIG_HOME/starship/starship.toml"
    # ===== END Initialize Starship prompt =====
else
    # ===== START Fallback prompt (optional) =====
    echo "⚠️  Neither Starship nor Powerlevel10k found. Using default Zsh prompt."
    PROMPT='%n@%m:%~ %# '
    # ===== END Fallback prompt =====
fi
# ===== END Initialize prompt =====

# Folders to load files from.
# Note: zcompletions is NOT sourced here — it is autoloaded by compinit via fpath
# (set in config/executable_completions.zsh).
ZSH_SOURCE_DIRS=(
  "$ZDOTDIR/config"
  "$ZDOTDIR/zfunctions"
  "$XDG_CONFIG_HOME/fzf"
)

# Source all files in those folders (one level deep)
for dir in "${ZSH_SOURCE_DIRS[@]}"; do
  [[ -d "$dir" ]] || continue
  for file in "$dir"/*; do
    [[ -f "$file" ]] && source "$file"
  done
done

# Run automatically in interactive shells
if [[ $- == *i* ]]; then
  gh-token
fi

