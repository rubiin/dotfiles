# Loaded by every shell (login, interactive, scripts). Put essential environment variables here—keep it minimal.

if [[ ("$SHLVL" -eq 1 && ! -o LOGIN) && -s "${ZDOTDIR:-$HOME}/.zprofile" ]]; then

  source "${ZDOTDIR:-$HOME}/.zprofile"

fi

# Vite+ bin (https://viteplus.dev)
. "$HOME/.config/vite-plus/env"

# Force sharp to use its prebuilt @img/sharp-* binaries.
# Without this, sharp's install script detects the system libvips (>= its minimum)
# and tries to compile from source, which fails when node-gyp isn't available.
export SHARP_IGNORE_GLOBAL_LIBVIPS=1
