{
  "instrumentation": {
    "performance_profiler": {
      "enabled": true
    }
  },
  "collaboration_panel": {
    "button": false
  },
  "bottom_dock_layout": "contained",
  "diagnostics": {
    "inline": {
      "enabled": false
    }
  },
  "toolbar": {
    "code_actions": false
  },
  "auto_update_extensions": {},
  "auto_signature_help": true,
  "diff_view_style": "split",
  "agent_ui_font_size": 13.0,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "markdown_preview_code_font_family": "MonoLisa",
  "markdown_preview_font_family": "MonoLisa",
  "ui_font_family": "MonoLisa",
  "sticky_scroll": {
    "enabled": true,
  },
  "git_panel": {
    "show_count_badge": true,
    "file_icons": false,
    "fallback_branch_name": "main",
    "status_style": "icon",
    "dock": "left",
    "button": true,
  },
  "outline_panel": {
    "git_status": true,
  },
  "agent": {
    "button": true,
    "dock": "right",
    "favorite_models": [],
    "model_parameters": [],
  },
  "tabs": {
    "file_icons": true,
    "git_status": true,
    "show_close_button": "hover",
    "activate_on_close": "neighbour",
    "show_diagnostics": "all",
  },
  "title_bar": {
    "show_branch_status_icon": true,
    "show_branch_name": true,
    "show_project_items": true,
    "show_onboarding_banner": true,
    "show_user_picture": true,
    "show_user_menu": true,
    "show_sign_in": true,
    "show_menus": true,
    "button_layout": "platform_default",
  },
  "status_bar": {
    "show_active_file": true,
    "line_endings_button": true,
    "active_encoding_button": "enabled",
  },

  "tab_bar": {
    "show": true,
    "show_nav_history_buttons": true,
    "show_tab_bar_buttons": true,
  },
  // Fonts
  "buffer_font_family": "MonoLisa",
  "buffer_font_fallbacks": ["Symbols Nerd Font"],
  "buffer_font_size": 13.5,
  "buffer_font_weight": 400,
  "ui_font_size": 15.0,
  "ui_font_weight": 500,
  "buffer_font_features": {
    "liga": true,
    "calt": true,
  },
  "ui_font_features": {
    "liga": true,
    "calt": true,
  },
  // Editing
  "tab_size": 2,
  "hard_tabs": false,
  "soft_wrap": "none",
  "show_whitespaces": "selection",
  "show_wrap_guides": true,
  "cursor_blink": true,
  "relative_line_numbers": "disabled",
  // Save
  "autosave": {
    "after_delay": {
      "milliseconds": 1000,
    },
  },
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "format_on_save": "off",
  // Completion
  "show_completions_on_input": true,
  "show_signature_help_after_edits": true,
  // Git
  "git": {
    "blame": {
      "show_avatar": true,
    },
    "inline_blame": {
      "show_commit_summary": true,
      "enabled": true,
    },
  },
  // Terminal
  "terminal": {
    "show_count_badge": true,
    "dock": "bottom",
    "font_size": 13.5,
    "font_family": "MonoLisa",
    "cursor_shape": "underline",
    "blinking": "on",
    "working_directory": "current_project_directory",
    "font_fallbacks": ["Symbols Nerd Font"],
    "detect_venv": {
      "on": {
        "directories": [".env", "env", ".venv", "venv"],
        "activate_script": "default",
      },
    },
  },
  // UI
  "scrollbar": {
    "show": "auto",
  },
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "code_lens": "on",
  "proxy": "",
  "colorize_brackets": true,
  "icon_theme": {
    "mode": "light",
    "light": "VSCode Great Icons Theme",
    "dark": "Clean VSCode Icon Theme"
  },
  "base_keymap": "JetBrains",

  // file panel
  "project_panel": {
    "bold_folder_labels": false,
    "dock": "left",
    "auto_fold_dirs": false,
    "git_status": true,
    "git_status_indicator": true,
    "auto_reveal_entries": true,
    "default_width": 250,
  },
  // Inlay hints preconfigured by Zed: Go, Rust, Typescript and Svelte
  "inlay_hints": {
    "enabled": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false,
  },
  "session": {
    "trust_all_worktrees": true,
  },
  // File syntax highlighting
  "file_types": {
    "Dockerfile": ["Dockerfile", "Dockerfile.*"],
    "JSON": ["json", "jsonc", "*.code-snippets"],
  },
  // Project panel exclusions
  "file_scan_exclusions": [
    "**/.git",
    "**/.svn",
    "**/.hg",
    "**/CVS",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.classpath",
    "**/.settings",
    // above is default from Zed
    "**/out",
    "**/dist",
    "**/.husky",
    "**/.turbo",
    "**/.vscode-test",
    "**/.vscode",
    "**/.next",
    "**/.storybook",
    "**/.tap",
    "**/.nyc_output",
    "**/report",
    "**/node_modules",
    "**/.github",
    "**/.nuxt",
    "**/.output",
    "**/.pnpm",
    "**/.yarn",
    "**/bower_components",
    "**/logs",
    "**/tmp",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
  ],

  // lsp

  "languages": {
    "Python": {
      "language_servers": [
        // Enable ty, disable basedpyright, and enable all
        // other registered language servers (ruff, pylsp, pyright).
        "!ty",
        "basedpyright",
        "...",
      ],
    },
  },

  "auto_install_extensions": {
    "git_firefly": true,
  },

  "minimap": {
    "show": "never",
  },
  "cli_default_open_behavior": "existing_window",
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "VSCode Modern Dark"
  },
}
