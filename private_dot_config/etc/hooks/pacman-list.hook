[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = *

[Action]
Description = Create a backup list of all installed packages
When = PreTransaction
Exec = /bin/sh -c 'pacman -Qqen > "${XDG_CONFIG_HOME:-$HOME/.config}/etc/pkglist.txt"; pacman -Qqem > "${XDG_CONFIG_HOME:-$HOME/.config}/etc/pkglist-aur.txt" 2>/dev/null'
